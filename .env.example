# Server
INROAD_ENV=development
INROAD_HTTP_ADDR=:8080
INROAD_PUBLIC_URL=http://localhost:8080

# Passkeys / WebAuthn Relying Party. Both default from INROAD_PUBLIC_URL's host
# and origin, so a single-host deploy needs neither. Set them explicitly when the
# browser origin differs from the API's public URL (e.g. the SPA is served from a
# separate domain). INROAD_RP_ID is the registrable domain WITHOUT scheme or port
# (e.g. app.example.com); INROAD_RP_ORIGIN is the exact browser origin WITH scheme
# and port (e.g. https://app.example.com). If neither can be derived nor is set,
# the passkey endpoints return 501 (feature off) rather than mis-validate.
# INROAD_RP_ID=app.example.com
# INROAD_RP_ORIGIN=https://app.example.com

# Postgres
# Dev DB (make db-up) is published on host port 5433 to avoid clashing with a
# native Postgres on 5432. The full `docker compose up` stack uses the internal
# network (postgres:5432) and is unaffected.
INROAD_DATABASE_URL=postgres://inroad:inroad@localhost:5433/inroad?sslmode=disable

# Redis
INROAD_REDIS_ADDR=localhost:6379

# Auth — generate with: openssl rand -base64 32
INROAD_JWT_SECRET=replace-me-with-32-byte-secret

# Signs open/click tracking tokens. Optional — falls back to INROAD_JWT_SECRET
# when unset; set a dedicated value so rotating tracking links doesn't
# invalidate sessions. generate with: openssl rand -base64 32
# INROAD_TRACKING_SECRET=

# Envelope encryption master key (base64 of 32 raw bytes) — openssl rand -base64 32
# Now the key-encryption key (KEK): it wraps the per-workspace data-encryption
# keys (DEKs) that seal mailbox creds/OAuth tokens. Losing it loses every secret.
INROAD_MASTER_KEY=replace-me-with-base64-32-bytes

# KEK backend that wraps per-workspace DEKs. "local" (default; blank == local)
# wraps under INROAD_MASTER_KEY. Only "local" is implemented — any other value
# is fatal at startup. A cloud KMS is a future provider behind the same seam.
INROAD_KEY_PROVIDER=local

# Token TTLs. The access token is short-lived and re-validated against the
# session store on every request (revocable sessions), so a revoke/logout takes
# effect within INROAD_SESSION_CACHE_TTL rather than the access TTL.
INROAD_ACCESS_TOKEN_TTL=5m
INROAD_REFRESH_TOKEN_TTL=720h
# How long the access-token verifier caches a session's revocation/token_version
# state in-process before re-reading Postgres. A revoke in this process busts the
# entry immediately; out-of-band changes propagate within this window. 0 disables.
INROAD_SESSION_CACHE_TTL=5s

# Cookie settings
INROAD_COOKIE_SECURE=false
INROAD_COOKIE_DOMAIN=

# Google OAuth for connecting Gmail mailboxes (leave blank to disable Gmail).
# Create an OAuth client (type: Web application) in Google Cloud Console and
# add INROAD_GOOGLE_REDIRECT_URL to its Authorized redirect URIs.
INROAD_GOOGLE_CLIENT_ID=
INROAD_GOOGLE_CLIENT_SECRET=
# Defaults to ${INROAD_PUBLIC_URL}/oauth/google/callback
INROAD_GOOGLE_REDIRECT_URL=

# Microsoft OAuth for connecting Microsoft 365 mailboxes (leave client id/secret
# blank to disable M365). Register an app in Entra ID (Azure AD) and add
# INROAD_MS_REDIRECT_URL to its redirect URIs.
INROAD_MS_CLIENT_ID=
INROAD_MS_CLIENT_SECRET=
# Defaults to ${INROAD_PUBLIC_URL}/oauth/microsoft/callback
INROAD_MS_REDIRECT_URL=
# Azure AD tenant/authority; "common" allows any tenant. Defaults to common.
INROAD_MS_TENANT=

# Worker identity + per-IP routing (spec §15). Only the worker binary reads
# these. Leave all blank for single-node dev: the worker id defaults to the
# hostname, no source IP is bound, and it consumes its own queue plus "default".
#
# Stable worker id; defaults to the OS hostname. Keys the worker's heartbeat row
# and names its dedicated queue ("w:<id>").
INROAD_WORKER_ID=
# Optional source IP outbound SMTP/IMAP dials bind to (net.Dialer.LocalAddr), so
# a mailbox's mail egresses from one IP. Blank = OS default route. Source-only:
# it never relaxes the SSRF destination vet.
INROAD_WORKER_EGRESS_IP=
# Comma-separated queues this worker consumes. Blank = "w:<INROAD_WORKER_ID>,default".
INROAD_WORKER_QUEUES=
