# --- web build ---
FROM node:26-alpine AS web
WORKDIR /web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
COPY api/ ../api/
RUN npm run gen:api && npm run build

# --- go build ---
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Stamped into internal/platform/version at link time so the running binary can
# report which release it is (startup log line, and any future /version route).
# An un-passed build keeps the package defaults ("dev"/"unknown"), which is what
# a plain `docker build` with no args produces.
ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown
ENV LDFLAGS="-s -w \
  -X github.com/inroad/inroad/internal/platform/version.Version=${VERSION} \
  -X github.com/inroad/inroad/internal/platform/version.Commit=${COMMIT} \
  -X github.com/inroad/inroad/internal/platform/version.Date=${DATE}"
RUN CGO_ENABLED=0 go build -trimpath -ldflags="${LDFLAGS}" -o /out/inroad ./cmd/inroad
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate

# --- runtime ---
FROM alpine:3.24
RUN adduser -D -u 10001 inroad
COPY --from=build /out/inroad /usr/local/bin/inroad
COPY --from=build /out/migrate /usr/local/bin/migrate
COPY --from=web /web/dist /srv/web
COPY deploy/docker/load-secrets.sh /usr/local/bin/load-secrets.sh
COPY deploy/docker/api-entrypoint.sh /usr/local/bin/api-entrypoint
RUN chmod 0444 /usr/local/bin/load-secrets.sh && chmod 0555 /usr/local/bin/api-entrypoint
USER inroad
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/api-entrypoint"]
