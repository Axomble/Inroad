FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/worker ./cmd/worker

FROM alpine:3.20
RUN adduser -D -u 10001 inroad
COPY --from=build /out/worker /usr/local/bin/worker
COPY deploy/docker/load-secrets.sh /usr/local/bin/load-secrets.sh
COPY deploy/docker/worker-entrypoint.sh /usr/local/bin/worker-entrypoint
RUN chmod 0444 /usr/local/bin/load-secrets.sh && chmod 0555 /usr/local/bin/worker-entrypoint
USER inroad
ENTRYPOINT ["/usr/local/bin/worker-entrypoint"]
