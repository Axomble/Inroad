FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# See Dockerfile.api for why these are stamped and what an un-passed build does.
ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown
ENV LDFLAGS="-s -w \
  -X github.com/inroad/inroad/internal/platform/version.Version=${VERSION} \
  -X github.com/inroad/inroad/internal/platform/version.Commit=${COMMIT} \
  -X github.com/inroad/inroad/internal/platform/version.Date=${DATE}"
RUN CGO_ENABLED=0 go build -trimpath -ldflags="${LDFLAGS}" -o /out/worker ./cmd/worker

FROM alpine:3.24
RUN adduser -D -u 10001 inroad
COPY --from=build /out/worker /usr/local/bin/worker
COPY deploy/docker/load-secrets.sh /usr/local/bin/load-secrets.sh
COPY deploy/docker/worker-entrypoint.sh /usr/local/bin/worker-entrypoint
RUN chmod 0444 /usr/local/bin/load-secrets.sh && chmod 0555 /usr/local/bin/worker-entrypoint
USER inroad
ENTRYPOINT ["/usr/local/bin/worker-entrypoint"]
